{
  "name": "castaway",
  "productName": "CASTAWAY",
  "version": "0.1.0",
  "description": "무인도 생존 게임",
  "license": "GPL-3.0",
  "author": "KJH-code",
  "repository": {
    "type": "git",
    "url": "https://github.com/KJH-code/castaway.git"
  },
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.kjhcode.castaway",
    "productName": "CASTAWAY",
    "copyright": "GPL-3.0",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../island_world.html",
        "to": "game/island_world.html"
      },
      {
        "from": "../three.min.js",
        "to": "game/three.min.js"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "CASTAWAY",
      "artifactName": "CASTAWAY-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "CASTAWAY-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games",
      "identity": null,
      "artifactName": "CASTAWAY-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "artifactName": "CASTAWAY-${version}-linux.${ext}"
    },
    "publish": null
  }
}
